<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h1 class="page-title"><i class="bi bi-calendar-check me-2"></i>Appointments <span class="badge bg-danger count-badge"><%= appointments.length %></span></h1>
    <p class="page-subtitle">Schedule and track patient visits</p>
  </div>
  <a href="/appointments/new" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Book Appointment</a>
</div>

<div class="card table-card">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-striped table-hover" id="appointmentsTable" data-paginate data-page-size="10">
        <thead>
          <tr>
            <th>ID</th>
            <th>Token</th>
            <th>Patient</th>
            <th>Doctor</th>
            <th>Treatment</th>
            <th>Treatment Cost</th>
            <th>Date & Time</th>
            <th>Status</th>
            <th>Notes</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% appointments.forEach(a => { %>
            <tr>
              <td><%= a.id %></td>
              <td><% if (a.token_no) { %><span class="badge bg-primary"><%= a.token_no %></span><% } else { %>-<% } %></td>
              <td><span class="avatar avatar-amber"><%= ((a.patient_name || '?')).charAt(0).toUpperCase() %></span><%= a.patient_name || 'N/A' %></td>
              <td><%= a.doctor_name || 'N/A' %></td>
              <td><%= a.treatment_name || 'N/A' %></td>
              <td><span class="badge bg-success"><%= a.treatment_cost != null ? '₹' + a.treatment_cost : 'N/A' %></span></td>
              <td><%= a.appointment_date ? new Date(a.appointment_date).toLocaleString() : 'N/A' %></td>
              <td>
                <span class="badge bg-<%= a.status === 'confirmed' ? 'success' : a.status === 'pending' ? 'warning' : a.status === 'cancelled' ? 'danger' : 'secondary' %>">
                  <%= a.status %>
                </span>
              </td>
              <td><%= a.notes || '' %></td>
              <td class="text-nowrap">
                <a href="/appointments/<%= a.id %>/consult" class="btn btn-sm btn-outline-success" title="Consult"><i class="bi bi-clipboard-pulse"></i></a>
                <a href="/appointments/<%= a.id %>/edit" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                <form action="/appointments/<%= a.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this appointment?')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% if (appointments.length === 0) { %>
        <div class="empty-state"><i class="bi bi-calendar-x d-block"></i>No appointments found. <a href="/appointments/new">Book your first appointment</a></div>
      <% } %>
    </div>
  </div>
</div>