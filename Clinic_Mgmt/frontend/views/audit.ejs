<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h1 class="page-title"><i class="bi bi-clock-history me-2"></i>Audit Trail <span class="badge bg-primary count-badge"><%= logs.length %></span></h1>
    <p class="page-subtitle">Who changed what, and when</p>
  </div>
</div>

<div class="card mb-4">
  <div class="card-body">
    <form action="/audit" method="GET" class="row g-2 align-items-end">
      <div class="col-md-4">
        <label class="form-label">Entity</label>
        <select name="entity" class="form-select">
          <option value="">All entities</option>
          <% ['user','patient','doctor','treatment','appointment','bill','payment','lookup','lookuptype','setting'].forEach(e => { %>
            <option value="<%= e %>" <%= entity === e ? 'selected' : '' %>><%= e %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i>Filter</button>
      </div>
    </form>
  </div>
</div>

<div class="card table-card">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-striped table-hover" id="auditTable" data-paginate data-page-size="10">
        <thead><tr><th>Time</th><th>Actor</th><th>Action</th><th>Entity</th><th>ID</th><th>Detail</th></tr></thead>
        <tbody>
          <% logs.forEach(l => { %>
            <tr>
              <td class="text-nowrap"><%= l.created_at ? new Date(l.created_at).toLocaleString() : '' %></td>
              <td><span class="avatar" style="width:28px;height:28px;font-size:0.75rem;"><%= (l.actor || '?').charAt(0).toUpperCase() %></span><%= l.actor %></td>
              <td><span class="badge bg-<%= l.action === 'create' ? 'success' : l.action === 'update' ? 'warning' : l.action === 'delete' ? 'danger' : 'info' %>"><%= l.action %></span></td>
              <td><%= l.entity %></td>
              <td><%= l.entity_id || '' %></td>
              <td><%= l.detail || '' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% if (logs.length === 0) { %>
        <div class="empty-state"><i class="bi bi-clock-history d-block"></i>No audit entries yet</div>
      <% } %>
    </div>
  </div>
</div>
