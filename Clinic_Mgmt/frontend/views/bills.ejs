<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h1 class="page-title"><i class="bi bi-receipt me-2"></i>Billing <span class="badge bg-primary count-badge"><%= bills.length %></span></h1>
    <p class="page-subtitle">Generate bills from appointments and track payments</p>
  </div>
</div>

<% if (error) { %>
  <div class="alert alert-danger d-flex align-items-center" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
  </div>
<% } %>

<% if (unbilled.length) { %>
<div class="card mb-4">
  <div class="card-header"><i class="bi bi-plus-circle me-1"></i>Appointments awaiting bills (<%= unbilled.length %>)</div>
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover">
        <thead><tr><th>Appointment</th><th>Patient</th><th>Doctor</th><th>Treatment</th><th>Date</th><th></th></tr></thead>
        <tbody>
          <% unbilled.forEach(a => { %>
            <tr>
              <td>#<%= a.id %></td>
              <td><%= a.patient_name || 'N/A' %></td>
              <td><%= a.doctor_name || 'N/A' %></td>
              <td><%= a.treatment_name || 'N/A' %></td>
              <td><%= a.appointment_date ? new Date(a.appointment_date).toLocaleDateString() : 'N/A' %></td>
              <td class="text-end">
                <form action="/bills/generate" method="POST" class="d-inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="appointment_id" value="<%= a.id %>">
                  <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-receipt me-1"></i>Generate Bill</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<% } %>

<div class="card table-card">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-striped table-hover" id="billsTable" data-paginate data-page-size="10">
        <thead>
          <tr>
            <th>Bill No</th>
            <th>Date</th>
            <th>Patient</th>
            <th>Treatment</th>
            <th>Total (&#8377;)</th>
            <th>Paid</th>
            <th>Balance</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% bills.forEach(b => { %>
            <tr>
              <td><strong class="bill-no"><%= b.bill_no %></strong></td>
              <td><%= b.created_at ? new Date(b.created_at).toLocaleDateString() : '' %></td>
              <td><%= b.patient_name || 'N/A' %></td>
              <td><%= b.treatment_name || 'N/A' %></td>
              <td>&#8377;<%= b.total %></td>
              <td>&#8377;<%= b.amount_paid %></td>
              <td>&#8377;<%= b.balance %></td>
              <td><span class="badge bg-<%= b.status === 'paid' ? 'success' : b.status === 'partial' ? 'warning' : 'danger' %>"><%= b.status %></span></td>
              <td class="text-end">
                <a href="/bills/<%= b.id %>" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye me-1"></i>View</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% if (bills.length === 0) { %>
        <div class="empty-state"><i class="bi bi-receipt d-block"></i>No bills yet — generate one from an appointment above</div>
      <% } %>
    </div>
  </div>
</div>
