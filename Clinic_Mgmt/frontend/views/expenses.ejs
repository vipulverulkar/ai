<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h1 class="page-title"><i class="bi bi-wallet2 me-2"></i>Expenses <span class="badge bg-primary count-badge"><%= expenses.length %></span></h1>
    <p class="page-subtitle">Clinic running costs &bull; Total: <strong>&#8377;<%= total %></strong></p>
  </div>
</div>

<% if (error) { %>
  <div class="alert alert-danger d-flex align-items-center" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
  </div>
<% } %>

<div class="card mb-4">
  <div class="card-header"><i class="bi bi-plus-circle me-1"></i>Record Expense</div>
  <div class="card-body">
    <form action="/expenses" method="POST" class="row g-2 align-items-end">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="col-md-3">
        <label class="form-label">Title *</label>
        <input type="text" name="title" class="form-control" placeholder="e.g. Syringes stock" required>
      </div>
      <div class="col-md-2">
        <label class="form-label">Category</label>
        <input type="text" name="category" class="form-control" placeholder="Supplies" value="General">
      </div>
      <div class="col-md-2">
        <label class="form-label">Amount (&#8377;) *</label>
        <input type="number" name="amount" class="form-control" min="0.01" step="0.01" required>
      </div>
      <div class="col-md-2">
        <label class="form-label">Date</label>
        <input type="date" name="expense_date" class="form-control">
      </div>
      <div class="col-md-2">
        <label class="form-label">Note</label>
        <input type="text" name="note" class="form-control">
      </div>
      <div class="col-md-1">
        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-plus-lg"></i></button>
      </div>
    </form>
  </div>
</div>

<div class="card table-card">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-striped table-hover" id="expensesTable" data-paginate data-page-size="10">
        <thead><tr><th>Date</th><th>Title</th><th>Category</th><th>Amount (&#8377;)</th><th>Note</th><th></th></tr></thead>
        <tbody>
          <% expenses.forEach(e => { %>
            <tr>
              <td><%= e.expense_date ? new Date(e.expense_date).toLocaleDateString() : '' %></td>
              <td><strong><%= e.title %></strong></td>
              <td><span class="badge bg-info text-dark"><%= e.category %></span></td>
              <td>&#8377;<%= e.amount %></td>
              <td><%= e.note || '' %></td>
              <td class="text-end">
                <form action="/expenses/<%= e.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this expense?')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% if (expenses.length === 0) { %>
        <div class="empty-state"><i class="bi bi-wallet2 d-block"></i>No expenses recorded</div>
      <% } %>
    </div>
  </div>
</div>
