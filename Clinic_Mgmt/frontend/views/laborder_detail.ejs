<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <a href="/lab-orders" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>All Orders</a>
  <button class="btn btn-sm btn-outline-primary" onclick="window.print()"><i class="bi bi-printer me-1"></i>Print Report</button>
</div>

<% if (error) { %>
  <div class="alert alert-danger d-flex align-items-center" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
  </div>
<% } %>

<div class="card mb-4">
  <div class="card-body d-flex flex-wrap gap-3 align-items-center">
    <div class="flex-grow-1">
      <h4 class="mb-0 bill-no"><%= order.order_no %></h4>
      <span class="text-muted"><%= order.patient_name || '' %> &bull; <%= order.created_at ? new Date(order.created_at).toLocaleString() : '' %></span>
    </div>
    <span class="badge bg-<%= order.priority === 'urgent' ? 'danger' : 'secondary' %>"><%= order.priority %></span>
    <span class="badge bg-<%= order.status === 'completed' ? 'success' : order.status === 'cancelled' ? 'danger' : order.status === 'ordered' ? 'warning' : 'info' %>"><%= order.status %></span>
    <strong class="fs-5">&#8377;<%= order.total %></strong>
  </div>
  <% if (nextStatuses.length) { %>
    <div class="card-footer d-flex flex-wrap gap-2">
      <span class="text-muted small align-self-center">Move to:</span>
      <% nextStatuses.forEach(s => { %>
        <form action="/lab-orders/<%= order.id %>/status" method="POST" class="d-inline" <%= s === 'cancelled' ? "onsubmit=\"return confirm('Cancel this order?')\"" : '' %>>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="status" value="<%= s %>">
          <button type="submit" class="btn btn-sm <%= s === 'completed' ? 'btn-success' : s === 'cancelled' ? 'btn-outline-danger' : 'btn-outline-primary' %>"><%= s %></button>
        </form>
      <% }) %>
    </div>
  <% } %>
</div>

<div class="card">
  <div class="card-header"><i class="bi bi-flask me-1"></i>Tests &amp; Results (<%= order.items.length %>)</div>
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover">
        <thead><tr><th>Test</th><th>Price (&#8377;)</th><th>Result</th><th>Flag</th><th>Note</th><th></th></tr></thead>
        <tbody>
          <% order.items.forEach(item => { %>
            <tr>
              <td><strong><%= item.test_name %></strong></td>
              <td>&#8377;<%= item.price %></td>
              <td colspan="4">
                <% if (['completed', 'cancelled'].includes(order.status)) { %>
                  <span class="fw-bold"><%= item.result_value || '—' %></span>
                  <% if (item.result_flag) { %><span class="badge bg-<%= item.result_flag === 'normal' ? 'success' : item.result_flag === 'critical' ? 'danger' : 'warning' %> ms-1"><%= item.result_flag %></span><% } %>
                  <% if (item.result_note) { %><br><small class="text-muted"><%= item.result_note %></small><% } %>
                <% } else { %>
                  <form action="/order-items/<%= item.id %>" method="POST" class="row g-2 align-items-end">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="col-md-4">
                      <input type="text" name="result_value" class="form-control form-control-sm" placeholder="Result value" value="<%= item.result_value || '' %>">
                    </div>
                    <div class="col-md-3">
                      <select name="result_flag" class="form-select form-select-sm">
                        <option value="">Flag...</option>
                        <% ['normal', 'high', 'low', 'critical'].forEach(f => { %>
                          <option value="<%= f %>" <%= item.result_flag === f ? 'selected' : '' %>><%= f %></option>
                        <% }) %>
                      </select>
                    </div>
                    <div class="col-md-3">
                      <input type="text" name="result_note" class="form-control form-control-sm" placeholder="Note" value="<%= item.result_note || '' %>">
                    </div>
                    <div class="col-md-2">
                      <button type="submit" class="btn btn-sm btn-primary w-100">Save</button>
                    </div>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
