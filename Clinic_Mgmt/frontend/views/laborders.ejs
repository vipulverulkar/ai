<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h1 class="page-title"><i class="bi bi-eyedropper me-2"></i>Lab Orders <span class="badge bg-primary count-badge"><%= orders.length %></span></h1>
    <p class="page-subtitle">Samples, results and reports</p>
  </div>
  <a href="/lab-orders/new" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New Order</a>
</div>

<% if (error) { %>
  <div class="alert alert-danger d-flex align-items-center" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
  </div>
<% } %>

<div class="card mb-4">
  <div class="card-body">
    <form action="/lab-orders" method="GET" class="row g-2 align-items-end">
      <div class="col-md-4">
        <label class="form-label">Status</label>
        <select name="status" class="form-select">
          <option value="">All statuses</option>
          <% ['ordered','collected','in_progress','completed','cancelled'].forEach(s => { %>
            <option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i>Filter</button>
      </div>
    </form>
  </div>
</div>

<div class="card table-card">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-striped table-hover" id="labOrdersTable" data-paginate data-page-size="10">
        <thead><tr><th>Order</th><th>Date</th><th>Patient</th><th>Tests</th><th>Total (&#8377;)</th><th>Priority</th><th>Status</th><th></th></tr></thead>
        <tbody>
          <% orders.forEach(o => { %>
            <tr>
              <td><strong class="bill-no"><%= o.order_no %></strong></td>
              <td><%= o.created_at ? new Date(o.created_at).toLocaleDateString() : '' %></td>
              <td><%= o.patient_name || 'N/A' %></td>
              <td><%= o.items.length %></td>
              <td>&#8377;<%= o.total %></td>
              <td><span class="badge bg-<%= o.priority === 'urgent' ? 'danger' : 'secondary' %>"><%= o.priority %></span></td>
              <td><span class="badge bg-<%= o.status === 'completed' ? 'success' : o.status === 'cancelled' ? 'danger' : o.status === 'ordered' ? 'warning' : 'info' %>"><%= o.status %></span></td>
              <td class="text-end text-nowrap">
                <a href="/lab-orders/<%= o.id %>" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye me-1"></i>Open</a>
                <% if (['ordered','cancelled'].includes(o.status)) { %>
                  <form action="/lab-orders/<%= o.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this order?')">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% if (orders.length === 0) { %>
        <div class="empty-state"><i class="bi bi-eyedropper d-block"></i>No lab orders found. <a href="/lab-orders/new">Create one</a></div>
      <% } %>
    </div>
  </div>
</div>
