<div class="row justify-content-center">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header form-card-header">
        <h4 class="mb-0"><i class="bi bi-flask me-2"></i><%= test ? 'Edit Lab Test' : 'Add New Lab Test' %></h4>
      </div>
      <div class="card-body">
        <% if (error) { %>
          <div class="alert alert-danger d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
          </div>
        <% } %>
        <form action="<%= test ? '/lab-tests/' + test.id : '/lab-tests' %>" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="row mb-3">
            <div class="col-md-6">
              <label class="form-label">Name *</label>
              <input type="text" name="name" class="form-control" value="<%= test?.name || '' %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Category</label>
              <input type="text" name="category" class="form-control" placeholder="e.g. Pathology" value="<%= test?.category || '' %>">
            </div>
          </div>
          <div class="row mb-3">
            <div class="col-md-6">
              <label class="form-label">Price (&#8377;) *</label>
              <input type="number" name="price" class="form-control" min="0" step="0.01" value="<%= test?.price ?? 0 %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Turnaround (hours)</label>
              <input type="number" name="turnaround_hours" class="form-control" min="1" value="<%= test?.turnaround_hours || 24 %>">
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea name="description" class="form-control" rows="2"><%= test?.description || '' %></textarea>
          </div>
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save</button>
            <a href="/lab-tests" class="btn btn-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
