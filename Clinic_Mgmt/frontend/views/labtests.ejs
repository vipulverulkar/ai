<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h1 class="page-title"><i class="bi bi-flask me-2"></i>Lab Tests <span class="badge bg-primary count-badge"><%= tests.length %></span></h1>
    <p class="page-subtitle">Test catalog with INR pricing</p>
  </div>
  <a href="/lab-tests/new" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add Test</a>
</div>

<% if (error) { %>
  <div class="alert alert-danger d-flex align-items-center" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
  </div>
<% } %>

<div class="card table-card">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-striped table-hover" id="labTestsTable" data-paginate data-page-size="10">
        <thead><tr><th>Name</th><th>Category</th><th>Price (&#8377;)</th><th>Turnaround</th><th>Status</th><th></th></tr></thead>
        <tbody>
          <% tests.forEach(t => { %>
            <tr>
              <td><strong><%= t.name %></strong><% if (t.description) { %><br><small class="text-muted"><%= t.description %></small><% } %></td>
              <td><span class="badge bg-info text-dark"><%= t.category %></span></td>
              <td>&#8377;<%= t.price %></td>
              <td><%= t.turnaround_hours %>h</td>
              <td><% if (t.is_active) { %><span class="badge bg-success">active</span><% } else { %><span class="badge bg-secondary">inactive</span><% } %></td>
              <td class="text-nowrap text-end">
                <a href="/lab-tests/<%= t.id %>/edit" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                <form action="/lab-tests/<%= t.id %>/toggle" method="POST" class="d-inline" title="Activate/Deactivate">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-sm <%= t.is_active ? 'btn-outline-success' : 'btn-outline-secondary' %>"><i class="bi <%= t.is_active ? 'bi-eye' : 'bi-eye-slash' %>"></i></button>
                </form>
                <form action="/lab-tests/<%= t.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this test?')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% if (tests.length === 0) { %>
        <div class="empty-state"><i class="bi bi-flask d-block"></i>No lab tests yet. <a href="/lab-tests/new">Add the first one</a></div>
      <% } %>
    </div>
  </div>
</div>
