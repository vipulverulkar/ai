<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - Clinic Management System</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0' y1='0' x2='1' y2='1'%3E%3Cstop offset='0' stop-color='%230d6efd'/%3E%3Cstop offset='1' stop-color='%236610f2'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='64' height='64' rx='14' fill='url(%23g)'/%3E%3Cpath d='M36 14h-8v14H14v8h14v14h8V36h14v-8H36z' fill='white'/%3E%3C/svg%3E">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script>
    try {
      document.documentElement.setAttribute('data-bs-theme', localStorage.getItem('clinic-bs') || 'light');
      document.documentElement.setAttribute('data-accent', localStorage.getItem('clinic-accent') || 'blue');
    } catch (e) {}
  </script>
</head>
<body class="login-split">
  <div class="login-panel d-none d-lg-flex">
    <div class="d-flex align-items-center gap-3 mb-4">
      <span class="login-logo"><i class="bi bi-hospital"></i></span>
      <div>
        <h2 class="mb-0"><%= (typeof clinic !== 'undefined' && clinic.clinic_name) || 'Clinic Management' %></h2>
        <p class="mb-0 opacity-75">Multi-Speciality Care, Organized</p>
      </div>
    </div>
    <div class="login-feature">
      <i class="bi bi-people"></i>
      <div><strong>Patients &amp; Doctors</strong><br><span class="opacity-75">Complete records with specializations and history.</span></div>
    </div>
    <div class="login-feature">
      <i class="bi bi-calendar-check"></i>
      <div><strong>Smart Scheduling</strong><br><span class="opacity-75">Book visits with live treatment pricing in &#8377;.</span></div>
    </div>
    <div class="login-feature">
      <i class="bi bi-shield-check"></i>
      <div><strong>Role-Based Access</strong><br><span class="opacity-75">Admins manage masters and users; staff run daily care.</span></div>
    </div>
  </div>
  <div class="login-main">
    <div class="dropdown login-theme-float">
      <button class="theme-picker-btn" data-bs-toggle="dropdown" type="button" aria-expanded="false"><i class="bi bi-palette-fill"></i></button>
      <ul class="dropdown-menu dropdown-menu-end themeMenu"></ul>
    </div>
    <div class="card login-card shadow-lg w-100 mx-3">
      <div class="card-body p-4 p-md-5">
        <div class="text-center mb-4 d-lg-none">
          <span class="login-logo"><i class="bi bi-hospital"></i></span>
        </div>
        <h3 class="fw-bold mb-1">Welcome back</h3>
        <p class="text-muted mb-4">Sign in to continue</p>
        <% if (error) { %>
          <div class="alert alert-danger d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
          </div>
        <% } %>
        <form action="/login" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="mb-3">
            <label class="form-label"><i class="bi bi-person me-1"></i>Username</label>
            <input type="text" name="username" class="form-control" placeholder="Enter username" required autofocus>
          </div>
          <div class="mb-4">
            <label class="form-label"><i class="bi bi-lock me-1"></i>Password</label>
            <input type="password" name="password" class="form-control" placeholder="Enter password" required>
          </div>
          <button type="submit" class="btn btn-primary w-100 py-2"><i class="bi bi-box-arrow-in-right me-1"></i>Login</button>
        </form>
      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
