<div class="mb-4">
  <a href="/masters" class="btn btn-sm btn-outline-secondary mb-3"><i class="bi bi-arrow-left me-1"></i>All Masters</a>
  <h1 class="page-title"><i class="bi <%= section.icon %> me-2"></i><%= section.label %> <span class="badge bg-primary count-badge"><%= values.length %></span></h1>
  <p class="page-subtitle"><%= section.description %></p>
</div>

<% if (error) { %>
  <div class="alert alert-danger d-flex align-items-center" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
  </div>
<% } %>

<div class="card mb-4">
  <div class="card-body">
    <form action="/masters/<%= key %>" method="POST" class="row g-2 align-items-end">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="col-md-8">
        <label class="form-label">New value</label>
        <input type="text" name="value" class="form-control" placeholder="<%= section.placeholder %>" required>
      </div>
      <div class="col-md-4">
        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i>Add</button>
      </div>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <% if (!values.length) { %>
      <div class="empty-state"><i class="bi <%= section.icon %> d-block"></i>No values yet — add the first one above</div>
    <% } else { %>
      <ul class="list-group list-group-flush">
        <% values.forEach(v => { %>
          <li class="list-group-item d-flex justify-content-between align-items-center px-0">
            <span>
              <%= v.value %>
              <% if (!v.is_active) { %><span class="badge bg-secondary ms-1">inactive</span><% } %>
            </span>
            <span class="text-nowrap">
              <form action="/masters/<%= v.id %>/toggle" method="POST" class="d-inline" title="<%= v.is_active ? 'Deactivate' : 'Activate' %>">
                <input type="hidden" name="returnTo" value="/masters/<%= key %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-sm <%= v.is_active ? 'btn-outline-success' : 'btn-outline-secondary' %>">
                  <i class="bi <%= v.is_active ? 'bi-eye' : 'bi-eye-slash' %>"></i>
                </button>
              </form>
              <form action="/masters/<%= v.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this value?')">
                <input type="hidden" name="returnTo" value="/masters/<%= key %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
              </form>
            </span>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>
</div>
