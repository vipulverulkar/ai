<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h1 class="page-title"><i class="bi bi-gear me-2"></i>Master Data</h1>
    <p class="page-subtitle">Dropdown values used across the app — stored in the database</p>
  </div>
</div>

<% if (error) { %>
  <div class="alert alert-danger"><%= error %></div>
<% } %>

<div class="row g-3 mb-4">
  <% sections.forEach(s => { %>
    <div class="col-md-4">
      <a href="/masters/<%= s.key %>" class="text-decoration-none">
        <div class="card stat-card stat-blue h-100">
          <div class="card-body d-flex align-items-center gap-3">
            <span class="stat-icon"><i class="bi <%= s.icon %>"></i></span>
            <div>
              <h5 class="mb-0 text-dark"><%= s.label %></h5>
              <small class="text-muted">Manage in a dedicated form<i class="bi bi-arrow-right ms-1"></i></small>
            </div>
          </div>
        </div>
      </a>
    </div>
  <% }) %>
</div>

<div class="card mb-4">
  <div class="card-body">
    <form action="/masters" method="POST" class="row g-2 align-items-end">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="col-md-4">
        <label class="form-label">Type</label>
        <select name="type" class="form-select" required>
          <% hubTypes.forEach(t => { %>
            <option value="<%= t.type %>"><%= t.label %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-5">
        <label class="form-label">New value</label>
        <input type="text" name="value" class="form-control" placeholder="Enter new value" required>
      </div>
      <div class="col-md-3">
        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-plus-lg me-1"></i>Add Value</button>
      </div>
    </form>
  </div>
</div>

<div class="row g-3">
  <% hubTypes.forEach(t => { %>
    <div class="col-md-6 col-lg-4">
      <div class="card h-100">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span><i class="bi <%= t.icon %> me-1"></i><%= t.label %></span>
          <span class="badge bg-primary count-badge"><%= (groups[t.type] || []).length %></span>
        </div>
        <div class="card-body">
          <% if (!(groups[t.type] && groups[t.type].length)) { %>
            <p class="text-muted mb-0">No values yet</p>
          <% } else { %>
            <ul class="list-group list-group-flush">
              <% groups[t.type].forEach(l => { %>
                <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                  <span>
                    <%= l.value %>
                    <% if (!l.is_active) { %><span class="badge bg-secondary ms-1">inactive</span><% } %>
                  </span>
                  <span class="text-nowrap">
                    <form action="/masters/<%= l.id %>/toggle" method="POST" class="d-inline" title="<%= l.is_active ? 'Deactivate' : 'Activate' %>">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-sm <%= l.is_active ? 'btn-outline-success' : 'btn-outline-secondary' %>">
                        <i class="bi <%= l.is_active ? 'bi-eye' : 'bi-eye-slash' %>"></i>
                      </button>
                    </form>
                    <form action="/masters/<%= l.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this value?')">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                    </form>
                  </span>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </div>
      </div>
    </div>
  <% }) %>
</div>
