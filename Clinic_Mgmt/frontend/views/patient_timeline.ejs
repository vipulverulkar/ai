<div class="mb-4">
  <a href="/patients" class="btn btn-sm btn-outline-secondary mb-3"><i class="bi bi-arrow-left me-1"></i>All Patients</a>
  <div class="card">
    <div class="card-body d-flex flex-wrap gap-3 align-items-center">
      <span class="avatar" style="width:52px;height:52px;font-size:1.3rem;"><%= ((patient.name || '?')).charAt(0).toUpperCase() %></span>
      <div class="flex-grow-1">
        <h3 class="mb-0"><%= patient.name %> <small class="text-muted"><%= patient.uhid || '' %></small></h3>
        <span class="text-muted"><%= patient.phone || '' %><% if (patient.email) { %> &bull; <%= patient.email %><% } %><% if (patient.emergency_contact) { %> &bull; SOS: <%= patient.emergency_contact %><% } %></span>
        <% if (patient.allergies) { %><div><span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle me-1"></i>Allergy: <%= patient.allergies %></span></div><% } %>
      </div>
      <div class="text-md-end">
        <% if (patient.blood_group) { %><span class="badge bg-danger me-1"><%= patient.blood_group %></span><% } %>
        <% if (patient.gender) { %><span class="badge bg-info text-dark me-1"><%= patient.gender %></span><% } %>
        <span class="badge bg-primary count-badge"><%= visits.length %> visits &bull; <%= bills.length %> bills</span>
        <a href="/lab-orders/new?patient_id=<%= patient.id %>" class="btn btn-sm btn-outline-primary ms-1"><i class="bi bi-eyedropper me-1"></i>Order Labs</a>
      </div>
    </div>
  </div>
  <% if (patient.medical_history) { %>
    <div class="alert alert-info mt-3 mb-0"><i class="bi bi-journal-medical me-1"></i><strong>History:</strong> <%= patient.medical_history %></div>
  <% } %>
</div>

<div class="row g-3">
  <div class="col-lg-7">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-calendar-check me-1"></i>Visit History</div>
      <div class="card-body">
        <% if (!visits.length) { %>
          <div class="empty-state"><i class="bi bi-calendar-x d-block"></i>No visits recorded</div>
        <% } else { %>
          <ul class="list-group list-group-flush">
            <% visits.slice().sort((a, b) => new Date(b.appointment_date) - new Date(a.appointment_date)).forEach(v => { %>
              <li class="list-group-item px-0">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                  <strong><%= v.appointment_date ? new Date(v.appointment_date).toLocaleDateString() : '' %></strong>
                  <span class="badge bg-<%= v.status === 'confirmed' ? 'success' : v.status === 'pending' ? 'warning' : 'danger' %>"><%= v.status %></span>
                </div>
                <div class="text-muted small"><%= v.doctor_name || '' %> &bull; <%= v.treatment_name || '' %></div>
                <% if (v.diagnosis) { %><div><i class="bi bi-clipboard-pulse me-1"></i><%= v.diagnosis %></div><% } %>
                <a href="/appointments/<%= v.id %>/consult" class="btn btn-sm btn-outline-success mt-1"><i class="bi bi-clipboard-pulse me-1"></i>Open consult</a>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </div>
  </div>
  <div class="col-lg-5">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-receipt me-1"></i>Billing History</div>
      <div class="card-body">
        <% if (!bills.length) { %>
          <div class="empty-state"><i class="bi bi-receipt d-block"></i>No bills yet</div>
        <% } else { %>
          <ul class="list-group list-group-flush">
            <% bills.slice().sort((a, b) => new Date(b.created_at) - new Date(a.created_at)).forEach(b => { %>
              <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                <span><strong class="bill-no"><%= b.bill_no %></strong><br><small class="text-muted"><%= b.created_at ? new Date(b.created_at).toLocaleDateString() : '' %></small></span>
                <span class="text-end"><strong>&#8377;<%= b.total %></strong><br>
                  <span class="badge bg-<%= b.status === 'paid' ? 'success' : b.status === 'partial' ? 'warning' : 'danger' %>"><%= b.status %></span>
                  <a href="/bills/<%= b.id %>" class="btn btn-sm btn-outline-primary ms-1">View</a>
                </span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </div>
    <div class="card mt-3">
      <div class="card-header"><i class="bi bi-eyedropper me-1"></i>Lab Orders (<%= (typeof labOrders !== 'undefined' ? labOrders : []).length %>)</div>
      <div class="card-body">
        <% const _lo = (typeof labOrders !== 'undefined' ? labOrders : []); %>
        <% if (!_lo.length) { %>
          <p class="text-muted mb-0">No lab orders</p>
        <% } else { %>
          <ul class="list-group list-group-flush">
            <% _lo.slice().sort((a, b) => new Date(b.created_at) - new Date(a.created_at)).forEach(o => { %>
              <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                <span><strong class="bill-no"><%= o.order_no %></strong><br><small class="text-muted"><%= o.items.length %> test(s) &bull; &#8377;<%= o.total %></small></span>
                <span><span class="badge bg-<%= o.status === 'completed' ? 'success' : o.status === 'cancelled' ? 'danger' : 'info' %> me-1"><%= o.status %></span>
                  <a href="/lab-orders/<%= o.id %>" class="btn btn-sm btn-outline-primary">Open</a></span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </div>
  </div>
</div>
