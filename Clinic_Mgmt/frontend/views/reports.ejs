<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h1 class="page-title"><i class="bi bi-graph-up me-2"></i>Reports</h1>
    <p class="page-subtitle">Revenue and appointment analytics</p>
  </div>
</div>

<div class="card mb-4">
  <div class="card-body">
    <form action="/reports" method="GET" class="row g-2 align-items-end">
      <div class="col-md-3">
        <label class="form-label">From</label>
        <input type="date" name="from" class="form-control" value="<%= from %>">
      </div>
      <div class="col-md-3">
        <label class="form-label">To</label>
        <input type="date" name="to" class="form-control" value="<%= to %>">
      </div>
      <div class="col-md-3">
        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i>Apply</button>
      </div>
      <div class="col-md-3">
        <div class="d-flex gap-2">
          <a href="/reports/revenue.csv?from=<%= from %>&to=<%= to %>" class="btn btn-outline-success flex-fill" title="Download revenue CSV"><i class="bi bi-download me-1"></i>Revenue</a>
          <a href="/reports/appointments.csv?from=<%= from %>&to=<%= to %>" class="btn btn-outline-success flex-fill" title="Download appointments CSV"><i class="bi bi-download me-1"></i>Visits</a>
        </div>
      </div>
    </form>
    <div class="d-flex flex-wrap gap-2 mt-3">
      <span class="text-muted small align-self-center">Quick ranges:</span>
      <a href="/reports?from=<%= presets.today %>&to=<%= presets.today %>" class="btn btn-sm btn-outline-secondary">Today</a>
      <a href="/reports?from=<%= presets.week %>&to=<%= presets.today %>" class="btn btn-sm btn-outline-secondary">Last 7 days</a>
      <a href="/reports?from=<%= presets.month %>&to=<%= presets.today %>" class="btn btn-sm btn-outline-secondary">This month</a>
      <a href="/reports?from=2000-01-01&to=<%= presets.today %>" class="btn btn-sm btn-outline-secondary">All time</a>
    </div>
  </div>
</div>

<% if (revenue) { %>
<div class="row mb-4 g-3">
  <div class="col-sm-6 col-lg-3">
    <div class="card stat-card stat-green compact h-100"><div class="card-body d-flex align-items-center gap-3">
      <span class="stat-icon"><i class="bi bi-cash-stack"></i></span>
      <div><p class="stat-value text-success">&#8377;<%= revenue.total_billed %></p><p class="stat-label">Total Billed</p></div>
    </div></div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="card stat-card stat-blue compact h-100"><div class="card-body d-flex align-items-center gap-3">
      <span class="stat-icon"><i class="bi bi-wallet2"></i></span>
      <div><p class="stat-value text-primary">&#8377;<%= revenue.total_collected %></p><p class="stat-label">Collected</p></div>
    </div></div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="card stat-card stat-rose compact h-100"><div class="card-body d-flex align-items-center gap-3">
      <span class="stat-icon"><i class="bi bi-exclamation-circle"></i></span>
      <div><p class="stat-value text-danger">&#8377;<%= revenue.outstanding %></p><p class="stat-label">Outstanding</p></div>
    </div></div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="card stat-card stat-amber compact h-100"><div class="card-body d-flex align-items-center gap-3">
      <span class="stat-icon"><i class="bi bi-receipt"></i></span>
      <div><p class="stat-value text-warning"><%= revenue.bill_count %></p><p class="stat-label">Bills</p></div>
    </div></div>
  </div>
</div>

<div class="row mb-4 g-3">
  <div class="col-sm-6 col-lg-4">
    <div class="card stat-card stat-blue compact h-100"><div class="card-body d-flex align-items-center gap-3">
      <span class="stat-icon"><i class="bi bi-percent"></i></span>
      <div><p class="stat-value text-primary"><%= revenue.total_billed ? Math.round(revenue.total_collected / revenue.total_billed * 1000) / 10 : 0 %>%</p><p class="stat-label">Collection Rate</p></div>
    </div></div>
  </div>
  <div class="col-sm-6 col-lg-4">
    <div class="card stat-card stat-amber compact h-100"><div class="card-body d-flex align-items-center gap-3">
      <span class="stat-icon"><i class="bi bi-receipt"></i></span>
      <div><p class="stat-value text-warning">&#8377;<%= revenue.bill_count ? Math.round(revenue.total_billed / revenue.bill_count) : 0 %></p><p class="stat-label">Avg Bill Value</p></div>
    </div></div>
  </div>
  <div class="col-sm-6 col-lg-4">
    <div class="card stat-card stat-rose compact h-100"><div class="card-body d-flex align-items-center gap-3">
      <span class="stat-icon"><i class="bi bi-exclamation-triangle"></i></span>
      <div><p class="stat-value text-danger"><%= outstanding.length %></p><p class="stat-label">Unpaid Bills in Range</p></div>
    </div></div>
  </div>
</div>

<div class="row mb-4 g-3">
  <div class="col-lg-8">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-graph-up-arrow me-1"></i>Daily Revenue (&#8377;)</div>
      <div class="card-body"><div class="chart-box"><canvas id="revenueChart"></canvas></div></div>
    </div>
  </div>
  <div class="col-lg-4">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-pie-chart me-1"></i>Bills by Status (&#8377;)</div>
      <div class="card-body"><div class="chart-box"><canvas id="billStatusChart"></canvas></div></div>
    </div>
  </div>
</div>

<div class="row g-3">
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-calendar3 me-1"></i>Daily Revenue</div>
      <div class="card-body">
        <% if (!revenue.by_day.length) { %><p class="text-muted mb-0">No billing data in range</p><% } else { %>
        <div class="table-responsive"><table class="table table-hover">
          <thead><tr><th>Date</th><th>Billed (&#8377;)</th><th>Collected (&#8377;)</th></tr></thead>
          <tbody><% revenue.by_day.forEach(d => { %>
            <tr><td><%= d.date %></td><td>&#8377;<%= d.billed %></td><td>&#8377;<%= d.collected %></td></tr>
          <% }) %></tbody>
        </table></div><% } %>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-pie-chart me-1"></i>By Status</div>
      <div class="card-body">
        <% Object.keys(revenue.by_status).forEach(s => { %>
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="badge bg-<%= s === 'paid' ? 'success' : s === 'partial' ? 'warning' : 'danger' %>"><%= s %></span>
            <strong>&#8377;<%= revenue.by_status[s] %></strong>
          </div>
        <% }) %>
        <% if (!Object.keys(revenue.by_status).length) { %><p class="text-muted mb-0">No data</p><% } %>
      </div>
    </div>
  </div>
</div>
<div class="row g-3 mt-1">
  <div class="col-lg-7">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-bar-chart-fill me-1"></i>Revenue by Treatment (&#8377;)</div>
      <div class="card-body"><div class="chart-box chart-box-lg"><canvas id="treatmentChart"></canvas></div></div>
    </div>
  </div>
  <div class="col-lg-5">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-pie-chart-fill me-1"></i>Collections by Method (&#8377;)</div>
      <div class="card-body"><div class="chart-box"><canvas id="methodChart"></canvas></div></div>
    </div>
  </div>
</div>
<% } %>

<div class="card mb-4">
  <div class="card-header"><i class="bi bi-exclamation-triangle me-1"></i>Outstanding Dues <span class="badge bg-danger count-badge"><%= outstanding.length %></span></div>
  <div class="card-body">
    <% if (!outstanding.length) { %>
      <p class="text-muted mb-0">Nothing outstanding in this range</p>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover">
          <thead><tr><th>Bill No</th><th>Patient</th><th>Date</th><th>Total (&#8377;)</th><th>Paid (&#8377;)</th><th>Balance (&#8377;)</th><th></th></tr></thead>
          <tbody>
            <% outstanding.forEach(b => { %>
              <tr>
                <td><strong><%= b.bill_no %></strong></td>
                <td><%= b.patient_name || 'N/A' %></td>
                <td><%= b.created_at ? new Date(b.created_at).toLocaleDateString() : '' %></td>
                <td>&#8377;<%= b.total %></td>
                <td>&#8377;<%= b.amount_paid %></td>
                <td class="fw-bold text-danger">&#8377;<%= b.balance %></td>
                <td class="text-end"><a href="/bills/<%= b.id %>" class="btn btn-sm btn-outline-primary">Collect</a></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<% if (appts) { %>
<div class="row g-3 mt-1">
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-pie-chart-fill me-1"></i>Appointments by Status</div>
      <div class="card-body"><div class="chart-box"><canvas id="apptStatusChart"></canvas></div></div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-bar-chart-fill me-1"></i>Appointments by Doctor</div>
      <div class="card-body"><div class="chart-box chart-box-lg"><canvas id="doctorChart"></canvas></div></div>
    </div>
  </div>
</div>
<div class="row g-3 mt-1">
  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-flag me-1"></i>Appointments by Status (<%= appts.total %>)</div>
      <div class="card-body">
        <% Object.keys(appts.by_status).forEach(s => { %>
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="badge bg-secondary"><%= s %></span><strong><%= appts.by_status[s] %></strong>
          </div>
        <% }) %>
        <% if (!Object.keys(appts.by_status).length) { %><p class="text-muted mb-0">No data</p><% } %>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-person-badge me-1"></i>By Doctor</div>
      <div class="card-body">
        <% Object.keys(appts.by_doctor).forEach(d => { %>
          <div class="d-flex justify-content-between align-items-center mb-2"><span><%= d %></span><strong><%= appts.by_doctor[d] %></strong></div>
        <% }) %>
        <% if (!Object.keys(appts.by_doctor).length) { %><p class="text-muted mb-0">No data</p><% } %>
      </div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100">
      <div class="card-header"><i class="bi bi-capsule me-1"></i>By Treatment</div>
      <div class="card-body">
        <% Object.keys(appts.by_treatment).forEach(t => { %>
          <div class="d-flex justify-content-between align-items-center mb-2"><span><%= t %></span><strong><%= appts.by_treatment[t] %></strong></div>
        <% }) %>
        <% if (!Object.keys(appts.by_treatment).length) { %><p class="text-muted mb-0">No data</p><% } %>
      </div>
    </div>
  </div>
</div>
<% } %>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
(function() {
  if (typeof Chart === 'undefined') return;
  var dark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
  Chart.defaults.color = dark ? '#9aa4c0' : '#6c757d';
  Chart.defaults.borderColor = dark ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.08)';
  Chart.defaults.font.family = "'Segoe UI', system-ui, -apple-system, sans-serif";
  Chart.defaults.font.size = 11;
  var revenue = <%- JSON.stringify(revenue || null) %>;
  var appts = <%- JSON.stringify(appts || null) %>;
  var css = getComputedStyle(document.documentElement);
  var brand1 = css.getPropertyValue('--brand-1').trim() || '#0d6efd';
  var brand2 = css.getPropertyValue('--brand-2').trim() || '#6610f2';
  var palette = ['#198754', brand1, '#dc3545', '#ffc107', brand2, '#0dcaf0', '#fd7e14'];
  function inr(v) { return '\u20B9' + Number(v).toLocaleString('en-IN'); }

  var rc = document.getElementById('revenueChart');
  if (rc && revenue && revenue.by_day && revenue.by_day.length) {
    new Chart(rc, {
      data: {
        labels: revenue.by_day.map(function(d) { return d.date; }),
        datasets: [
          { type: 'bar', label: 'Billed', data: revenue.by_day.map(function(d) { return d.billed; }),
            backgroundColor: brand1 + 'CC', borderRadius: 8 },
          { type: 'line', label: 'Collected', data: revenue.by_day.map(function(d) { return d.collected; }),
            borderColor: '#198754', backgroundColor: '#198754', tension: 0.35, fill: false, pointRadius: 4 }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { position: 'bottom', labels: { boxWidth: 12 } }, tooltip: { callbacks: { label: function(c) { return ' ' + c.dataset.label + ': ' + inr(c.parsed.y); } } } },
        scales: { y: { ticks: { callback: function(v) { return '\u20B9' + v; } } } }
      }
    });
  }
  function doughnut(id, obj, money) {
    var el = document.getElementById(id);
    if (!el || !obj || !Object.keys(obj).length) return;
    new Chart(el, {
      type: 'doughnut',
      data: {
        labels: Object.keys(obj),
        datasets: [{ data: Object.values(obj), backgroundColor: palette, borderWidth: 2, hoverOffset: 8 }]
      },
      options: {
        responsive: true, maintainAspectRatio: false, cutout: '62%',
        plugins: { legend: { position: 'bottom', labels: { boxWidth: 12 } },
          tooltip: { callbacks: { label: function(c) { return ' ' + c.label + ': ' + (money ? inr(c.parsed) : c.parsed); } } } }
      }
    });
  }
  if (revenue) doughnut('billStatusChart', revenue.by_status, true);
  if (appts) doughnut('apptStatusChart', appts.by_status, false);

  var dc = document.getElementById('doctorChart');
  if (dc && appts && appts.by_doctor && Object.keys(appts.by_doctor).length) {
    var names = Object.keys(appts.by_doctor);
    new Chart(dc, {
      type: 'bar',
      data: {
        labels: names,
        datasets: [{ data: names.map(function(n) { return appts.by_doctor[n]; }),
          backgroundColor: names.map(function(_, i) { return palette[i % palette.length] + 'CC'; }),
          borderRadius: 8 }]
      },
      options: {
        indexAxis: 'y', responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: { x: { ticks: { precision: 0 } } }
      }
    });
  }
  var tc = document.getElementById('treatmentChart');
  if (tc && revenue && revenue.by_treatment && Object.keys(revenue.by_treatment).length) {
    var tnames = Object.keys(revenue.by_treatment);
    new Chart(tc, {
      type: 'bar',
      data: {
        labels: tnames,
        datasets: [{ data: tnames.map(function(n) { return revenue.by_treatment[n]; }),
          backgroundColor: tnames.map(function(_, i) { return palette[i % palette.length] + 'CC'; }),
          borderRadius: 8 }]
      },
      options: {
        indexAxis: 'y', responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false },
          tooltip: { callbacks: { label: function(c) { return ' ' + inr(c.parsed.x); } } } },
        scales: { x: { ticks: { callback: function(v) { return '\u20B9' + v; } } } }
      }
    });
  }
  if (revenue) doughnut('methodChart', revenue.by_method, true);
})();
</script>
