<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h1 class="page-title"><i class="bi bi-shield-check me-2"></i>Active Sessions <span class="badge bg-primary count-badge"><%= sessions.length %></span></h1>
    <p class="page-subtitle">Who is currently logged in — revoke any session except your own</p>
  </div>
</div>

<div class="card table-card">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-striped table-hover">
        <thead><tr><th>Session</th><th>User</th><th>Expires</th><th></th></tr></thead>
        <tbody>
          <% sessions.forEach(s => { %>
            <tr>
              <td><code><%= s.short %>...</code><% if (s.sid === currentSid) { %> <span class="badge bg-success">this device</span><% } %></td>
              <td><strong><%= s.username %></strong></td>
              <td><%= s.expires ? new Date(s.expires).toLocaleString() : 'session' %></td>
              <td class="text-end">
                <% if (s.sid !== currentSid) { %>
                  <form action="/sessions/<%= s.sid %>/revoke" method="POST" class="d-inline" onsubmit="return confirm('Revoke this session? The user will be logged out.')">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Revoke</button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% if (sessions.length === 0) { %>
        <div class="empty-state"><i class="bi bi-shield-check d-block"></i>No stored sessions</div>
      <% } %>
    </div>
  </div>
</div>
