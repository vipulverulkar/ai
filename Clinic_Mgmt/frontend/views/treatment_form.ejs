<div class="row justify-content-center">
  <div class="col-md-8">
    <div class="card">
      <div class="card-header form-card-header">
        <h4 class="mb-0"><i class="bi bi-capsule me-2"></i><%= treatment ? 'Edit Treatment' : 'Add New Treatment' %></h4>
      </div>
      <div class="card-body">
        <form action="<%= treatment ? '/treatments/' + treatment.id : '/treatments' %>" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="row mb-3">
            <div class="col-md-6">
              <label class="form-label">Name *</label>
              <input type="text" name="name" class="form-control" value="<%= treatment?.name || '' %>" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Category *</label>
              <select name="category" class="form-select" required>
                <option value="">Select</option>
                <% (typeof categories !== 'undefined' ? categories : []).forEach(c => { %>
                  <option value="<%= c %>" <%= treatment?.category === c ? 'selected' : '' %>><%= c %></option>
                <% }) %>
              </select>
            </div>
          </div>
          <div class="row mb-3">
            <div class="col-md-6">
              <label class="form-label">Duration (minutes) *</label>
              <input type="number" name="duration_minutes" class="form-control" value="<%= treatment?.duration_minutes || 30 %>" min="1" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Cost (₹) *</label>
              <input type="number" name="cost" class="form-control" value="<%= treatment?.cost || 0 %>" min="0" step="0.01" required>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea name="description" class="form-control" rows="3"><%= treatment?.description || '' %></textarea>
          </div>
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save</button>
            <a href="/treatments" class="btn btn-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>