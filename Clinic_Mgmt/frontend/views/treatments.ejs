<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h1 class="page-title"><i class="bi bi-capsule me-2"></i>Treatments <span class="badge bg-warning text-dark count-badge"><%= treatments.length %></span></h1>
    <p class="page-subtitle">Treatment catalog with categories and pricing</p>
  </div>
  <a href="/treatments/new" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add Treatment</a>
</div>

<div class="card table-card">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-striped table-hover" id="treatmentsTable" data-paginate data-page-size="10">
        <thead>
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Category</th>
            <th>Description</th>
            <th>Duration (min)</th>
            <th>Cost</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% treatments.forEach(t => { %>
            <tr>
              <td><%= t.id %></td>
              <td><strong><%= t.name %></strong></td>
              <td><span class="badge bg-info text-dark"><%= t.category %></span></td>
              <td><%= t.description %></td>
              <td><%= t.duration_minutes %> min</td>
              <td>₹<%= t.cost %></td>
              <td class="text-nowrap">
                <a href="/treatments/<%= t.id %>/edit" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                <form action="/treatments/<%= t.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this treatment?')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% if (treatments.length === 0) { %>
        <div class="empty-state"><i class="bi bi-capsule d-block"></i>No treatments found. <a href="/treatments/new">Add your first treatment</a></div>
      <% } %>
    </div>
  </div>
</div>