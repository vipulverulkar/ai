<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
  <div>
    <h1 class="page-title"><i class="bi bi-person-gear me-2"></i>Users <span class="badge bg-primary count-badge"><%= users.length %></span></h1>
    <p class="page-subtitle">Admins can add, edit or delete user accounts</p>
  </div>
  <a href="/users/new" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add User</a>
</div>

<% if (error) { %>
  <div class="alert alert-danger d-flex align-items-center" role="alert">
    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
  </div>
<% } %>

<div class="card table-card">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-striped table-hover" id="usersTable" data-paginate data-page-size="10">
        <thead>
          <tr>
            <th>ID</th>
            <th>Username</th>
            <th>Role</th>
            <th>Created</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(u => { %>
            <tr>
              <td><%= u.id %></td>
              <td>
                <span class="avatar <%= u.role === 'admin' ? '' : 'avatar-green' %>"><%= (u.username || '?').charAt(0).toUpperCase() %></span><%= u.username %>
                <% if (typeof user !== 'undefined' && user && user.id === u.id) { %>
                  <span class="badge bg-secondary ms-1">you</span>
                <% } %>
              </td>
              <td><span class="badge bg-<%= u.role === 'admin' ? 'danger' : 'success' %>"><%= u.role %></span></td>
              <td><%= u.created_at ? new Date(u.created_at).toLocaleDateString() : '' %></td>
              <td class="text-nowrap">
                <a href="/users/<%= u.id %>/edit" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                <form action="/users/<%= u.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this user?')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% if (users.length === 0) { %>
        <div class="empty-state"><i class="bi bi-person-gear d-block"></i>No users found. <a href="/users/new">Add your first user</a></div>
      <% } %>
    </div>
  </div>
</div>
