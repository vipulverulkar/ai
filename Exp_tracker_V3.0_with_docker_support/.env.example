# Copy to .env and adjust. Never commit .env with real secrets.
SECRET_KEY=change-me-to-a-long-random-string
CURRENCY_SYMBOL=₹
# EXPENSE_DB=/data/expenses.db
# PORT=5000
# Auto-logout after this many idle minutes (default 15).
# Each user can override it on their Profile page.
# SESSION_TIMEOUT_MINUTES=15
# Database backend: sqlite (default, zero setup) or postgres.
# When DB_TYPE is unset, the backend auto-detects: postgres if DATABASE_URL
# is set, sqlite otherwise.
# DB_TYPE=sqlite
# PostgreSQL (set DB_TYPE=postgres and provide the DSN):
# DB_TYPE=postgres
# DATABASE_URL=postgresql://user:password@localhost:5432/exptracker
# Multi-currency: base currency + static rates (1 unit -> N units of base).
# BASE_CURRENCY=INR
# CURRENCY_RATES={"USD": 83.5, "EUR": 90.1}
# Live FX rates (daily refresh from open.er-api.com, cached locally):
# FETCH_FX_RATES=1
# FX_CACHE_FILE=/data/fx_rates.json
# Server-side sessions: filesystem (default) or cookie.
# SESSION_TYPE=filesystem
# SESSION_FILE_DIR=/data/flask_sessions
# Rate limiter storage for multi-worker deployments (needs redis package):
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
# Automatic JSON backup on startup, keep the newest 10 files:
# AUTO_BACKUP=1
# BACKUP_DIR=/data/backups
# BACKUP_KEEP=10
# Purge audit entries older than N days on startup (0 = keep all):
# AUDIT_RETENTION_DAYS=90
# Optional monitoring (guarded imports — app runs fine without them):
# SENTRY_DSN=https://your-key@sentry.example/1
# Prometheus metrics are served at /metrics when prometheus-client is installed.
